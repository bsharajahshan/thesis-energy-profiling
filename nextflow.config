// nextflow.config - Energy Profiling Benchmark

nextflow.enable.dsl = 2

params {
    // Execution mode: baseline, mixed, granularity
    mode = "baseline"

    // Results output directory
    results_dir = "results/raw"

    // Experiment parameters
    subsystem = "cpu"          // cpu, memory, io
    duration = 60              // seconds
    intensity = 1              // load intensity (1-8)
    task_count = 1             // number of parallel tasks
    repetitions = 5            // number of experiment repetitions
}

process {
    executor = 'local'

    // Resource limits (conservative for typical Linux machines)
    cpus = 4
    memory = '8 GB'
    time = '1h'
}

// Caps the local executor's total resource pool at exactly one task's
// request (cpus=4 above). Without this, Nextflow auto-detects the host's
// real core count (8 logical cores) and can legally admit two task
// instances at once (2 x 4 <= 8) — which corrupts RAPL readings, since it
// is one shared system-wide counter and measure_rapl.sh's before/after
// window is only valid if nothing else is running concurrently. This
// serializes every process across RQ1/RQ2/RQ3 uniformly; per-process
// maxForks guards are not needed on top of this.
executor {
    $local {
        cpus = 4
        memory = '8 GB'
    }
}

profiles {
    local {
        process.executor = 'local'
    }
}
