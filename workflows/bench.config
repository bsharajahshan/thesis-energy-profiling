// bench.config - the only Nextflow config of the fixed-work benchmark.
// Used with `nextflow -C workflows/bench.config run workflows/bench.nf ...`
// (-C: no other config file is read, not even ~/.nextflow/config).
//
// Replaces the October setting `executor.$local.cpus`, which Nextflow 26
// did not recognise (warning in every log of the October runs).

params {
    spec         = null        // one run spec (bench.nf starts one run per call, see there)
    session_env  = null
    runs_dir     = null
    bench_dir    = null        // default: scripts/bench next to the workflows folder
    max_attempts = 3
}

executor {
    name         = 'local'
    queueSize    = 1           // one task at a time ...
    pollInterval = '1 sec'     // ... and the JVM checks for its end only once a second
}

process {
    executor = 'local'
    cpus     = 1               // bookkeeping only; run_case.sh starts its own workers
    maxForks = 1
}

// Off on purpose: with trace/report/timeline on, Nextflow wraps every task in
// a monitor that samples /proc during the run, i.e. during the measurement.
trace.enabled    = false
report.enabled   = false
timeline.enabled = false
dag.enabled      = false
