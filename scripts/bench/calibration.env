# calibration.env - every number of the fixed-work benchmark that the pilot decides.
#
# STATUS (2026-10-30): CPU, I/O, cooling, background and power values from the
# pilot on the laptop (2026-10-29, calibration_report.txt of thesis_pilot.tar.gz).
# MEMORY values are still open: in the pilot, stress-ng --vm with method 'all'
# did not move a fixed amount of data per operation, so the memory check
# (run.sh memcheck) chooses one vm method and sizes the memory jobs. Only this
# file changes when a job size changes; the case list (cases.py) and the run
# order (schedules/) stay.
#
# Format: KEY=value, read by benchlib.read_env (no spaces around '=').

# ---- job sizes -------------------------------------------------------------
# CPU job: stress-ng --cpu-method all, the same total bogo-ops for 1, 2, 4, 8
# threads; sized so that 8 threads take about 60 s. Must be a multiple of 8
# (RQ3 splits it into 2, 4, 8 equal sub-tasks).
# Pilot: 6860 ops/s with 8 threads; 3 repeats 59.1 s, instructions per op spread 0.1 %.
CPU_OPS=412000

# Memory job: stress-ng --vm 1 --vm-method VM_METHOD (--vm-keep if VM_KEEP=1:
# the buffer is mapped once, not again for every operation), bogo-ops per
# buffer size chosen so that every size moves the same amount of DRAM data
# (perf uncore_imc) and the 8 GB job takes about 60 s. The memory check
# replaces these placeholders (pilot values for method 'all' without --vm-keep).
VM_METHOD=all
VM_KEEP=1
VM_OPS_1G=2938336
VM_OPS_2G=4501720
VM_OPS_4G=2155520
VM_OPS_8G=1304528

# I/O job: bytes written by fio (4 KiB blocks, every block once, fsync at the
# end), sized so that the sequential job takes about 60 s. Multiple of 4096.
# Pilot: 105 MiB/s sequential; 3 repeats 58.1 s (spread 3.4 %).
IO_BYTES=6623854592

# Mechanism block (fixed time, operations per second) and idle runs, seconds.
MECH_FIXED_S=60
IDLE_S=60

# Pilot probes (calibrate.py computes the job sizes from them): length of a
# speed probe, bytes of the I/O probes, idle time after the heavy part of the
# cooling probe, operations asked in the stress-ng counting probe.
PROBE_S=30
PROBE_IO_BYTES=4294967296
PROBE_COOLDOWN_S=300
PROBE_SEMANTICS_OPS=20000
# Memory check: it tries the vm methods all, write64, read64 and wrrd128nt
# (with --vm-keep) at every buffer size. The method whose data per operation
# is the same at all four sizes wins (then a fixed number of operations is a
# fixed amount of data at every size and in every RQ3 split); 'all' is kept
# only if its spread is at most MEMCHECK_KEEP_ALL_PCT points above the best.
# First memory check (2026-10-30): write64 about 2 MiB per operation at every
# size (spread about 0.5 %), wrrd128nt about 4 %, all about 27 %, read64 no data.
MEMCHECK_KEEP_ALL_PCT=2

# ---- expected times (seconds) -------------------------------------------------
# Used only for the watchdog (a run is stopped after 5 x this) and for the
# session time estimate. Rough values are enough.
CPU_S_T1=242.4
CPU_S_T2=131.1
CPU_S_T4=72.5
CPU_S_T8=60.1
CPU_S_T8_LOAD50=128.4
CPU_S_T8_LOAD25=214.0
VM_S=67.4
IO_S_SEQ=60.0
IO_S_RAND=53.1

# ---- machine settings ---------------------------------------------------------
# Main runs: Ubuntu's defaults (power profile 'balanced', governor 'powersave').
# EPP_MAIN is the value the 'balanced' profile sets (confirmed by the pilot).
POWER_PROFILE=balanced
GOVERNOR_MAIN=powersave
EPP_MAIN=balance_performance
GOVERNOR_CONTROL=performance

# How stress-ng 0.17.06 reads --cpu-ops / --vm-ops: 'total' (all workers
# together) or 'per_instance'. Pilot: total (20020 done of 20000 asked, 4 workers).
OPS_SEMANTICS=total

# ---- session rules (copied into the session env) ------------------------------------
# Pilot: package 71 C at the end of 60 s with 8 threads, 49 C 60 s later.
SETTLE_TEMP_C=49
SETTLE_MIN_S=5
SETTLE_MAX_S=300
# Pilot: other programs 0.06 CPUs during the idle probe (opencode was running).
OTHER_CPU_LIMIT=0.12
DISK_KEEP_FREE_KB=3145728
# Attempts per run in one pass (the repair pass at the end gives as many again).
MAX_ATTEMPTS=3
# A run waits this long for the power cable; the session itself waits longer
# and stops cleanly (to be continued later) when the battery is at BATTERY_STOP_PCT.
AC_WAIT_MAX_S=600
BATTERY_STOP_PCT=30
POWER_POLL_S=30
# Before the first run the session waits up to GRACE_MAX_S for these programs
# to close and for the background load to drop below BG_CPU_MAX busy CPUs;
# then it starts anyway and writes a warning into the summary.
GRACE_MAX_S=1200
WAIT_FOR_GONE='opencode hermes firefox chrome chromium code'
BG_CPU_MAX=0.15
# For the time estimate only: average wait before a run (pilot median 20 s),
# start-up of one Nextflow call, and the cooling break between rounds.
SETTLE_EST_S=25
NXF_START_S=5
BREAK_S=600
