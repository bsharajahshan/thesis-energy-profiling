# calibration.env - values that fix the AMOUNT OF WORK of every job. Copy to calibration.env and fill in
# with the results of the pilot (pilot_a.sh / pilot_b.sh). run_case.sh refuses to run without it.
# The numbers below are PLACEHOLDERS, not results.

# --- CPU job: stress-ng --cpu T --cpu-method $CPU_METHOD --cpu-ops <ops> ---------------------------------
CPU_METHOD=matrixprod          # pilot decides (CPU-bound, stable ops/s, scales with threads, little DRAM traffic)
CPU_OPS_TOTAL=100000           # bogo-ops of the whole job, chosen so the 8-thread job takes about 60 s
CPU_OPS_SEMANTICS=total        # total | per_worker : does --cpu-ops count all workers together? (pilot checks)

# --- memory job: stress-ng --vm 1 --vm-bytes <C>G --vm-method $VM_METHOD --vm-ops <ops> -------------------
VM_METHOD=write64              # pilot decides
VM_TARGET_GIB=300              # GiB moved by the whole memory job, chosen so the 8 GB job takes about 60 s
# bogo-ops per GiB moved, for each buffer size C used in RQ1 and RQ3 (the bogo-op unit depends on C; pilot_b
# measures it with the perf uncore_imc counters):
VM_OPS_PER_GIB_C1=7000
VM_OPS_PER_GIB_C2=7000
VM_OPS_PER_GIB_C4=7000
VM_OPS_PER_GIB_C8=7000

# --- I/O job: fio, buffered writes, fsync at the end -----------------------------------------------------
IO_TOTAL_GIB=8                 # GiB written by the whole I/O job (pilot checks it takes about 60 s)
IO_BS=4k
IO_DEPTH=16

# --- safety and instrumentation ---------------------------------------------------------------------------
WATCHDOG_S=1200                # stress-ng --timeout, only a safety limit; a run that hits it is flagged work_complete=0
PERF_ON=1                      # perf stat -a around every workload (instructions, cycles, DRAM traffic)
PERF_EVENTS="instructions,cycles,uncore_imc/data_reads/,uncore_imc/data_writes/"
TURBOSTAT_COLUMNS="Time_Of_Day_Seconds,Avg_MHz,Bzy_MHz,Busy%,PkgTmp,PkgWatt,RAMWatt"   # pilot checks which exist
TURBOSTAT_INTERVAL=2
